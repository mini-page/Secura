# Secura Django Backend Configuration
# Copy this to .env and fill in the values

# Security
DJANGO_SECRET_KEY="your-super-secret-django-key"
DEBUG=True

# Database (MySQL)
DB_NAME="secura"
DB_USER="root"
DB_PASSWORD="your_password"
DB_HOST="localhost"
DB_PORT="3306"

# Google OAuth2 (Required for Google Login)
# Get this from Google Cloud Console > Credentials > Web Client ID
GOOGLE_CLIENT_ID="791143848111-pt4asks5jstbb9njtnrdhsh14uocq2bo.apps.googleusercontent.com"

# JWT Settings
JWT_SECRET_KEY="another-random-secret-for-jwts"

# Cryptography (Legacy/Server-side Backup)
AES_KEY_BASE64="your-base64-encoded-32-byte-key"

# Storage
STORAGE_DIR="./storage"
